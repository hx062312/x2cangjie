    "short": "Int16",
    "int": "Int32",
    "long": "Int64",
    "float": "Float32",
    "double": "Float64",
    "boolean": "Bool",
    "char": "Rune",
    "void": "Unit",
    "String": "String",
    "Object": "Any",
    "Byte": "Int8",
    "Short": "Int16",
    "Integer": "Int32",
    "Long": "Int64",
    "Float": "Float32",
    "Double": "Float64",
