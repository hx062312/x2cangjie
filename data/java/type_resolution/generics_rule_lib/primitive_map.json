    "Character": "Rune",
    "Number": "Number",
    "Comparable": "Comparable",
    "Serializable": "Serializable",
    "Cloneable": "Cloneable",
    "Iterable": "Iterable",
    "Iterator": "Iterator",
    "Collection": "Collection",
    "List": "ArrayList",
    "ArrayList": "ArrayList",
    "LinkedList": "LinkedList",
    "Map": "HashMap",
    "HashMap": "HashMap",
    "LinkedHashMap": "LinkedHashMap",
    "TreeMap": "TreeMap",
    "Set": "HashSet",
    "HashSet": "HashSet",
    "LinkedHashSet": "LinkedHashSet",
    "TreeSet": "TreeSet",
