            "        assertArrayEquals(new String[] {\"key\", \"value\", \"key\", \"value\"}, cmd.getOptionValues0('j'));",
            "",
            "        assertTrue(\"Option k is not set\", cmd.hasOption2(\"k\"));",
            "        assertTrue(\"Option k is not set\", cmd.hasOption0('k'));",
