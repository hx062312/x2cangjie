    public static Kernel32_INPUT_RECORD[] readConsoleKeyInput(long handle, int count, boolean peek) throws IOException {
        while (true) {
            // read events until we have keyboard events, the queue could be full
            // of mouse events.
            Kernel32_INPUT_RECORD[] evts = readConsoleInputHelper(handle, count, peek);
            int keyEvtCount = 0;
            for (Kernel32_INPUT_RECORD evt : evts) {
                if (evt.eventType == Kernel32_INPUT_RECORD.KEY_EVENT) keyEvtCount++;
            }
            if (keyEvtCount > 0) {
                Kernel32_INPUT_RECORD[] res = new Kernel32_INPUT_RECORD[keyEvtCount];
                int i = 0;
                for (Kernel32_INPUT_RECORD evt : evts) {
                    if (evt.eventType == Kernel32_INPUT_RECORD.KEY_EVENT) {
                        res[i++] = evt;
                    }
                }
                return res;
            }
        }
    }
```

