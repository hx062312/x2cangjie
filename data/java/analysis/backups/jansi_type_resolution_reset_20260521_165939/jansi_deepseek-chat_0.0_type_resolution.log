                // ANSI-enabled ConEmu, Cygwin or MSYS(2) on Windows...
                processor = null;
                type__ = AnsiType.Native;
                installer = uninstaller = null;
                MingwSupport mingw = new MingwSupport();
                String name = mingw.getConsoleName(stdout);
                if (name != null && !name.isEmpty()) {
