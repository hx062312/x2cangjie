    private static int readNBytes(InputStream in__, byte[] b) throws IOException {
        int n = 0;
        int len = b.length;
        while (n < len) {
            int count = in__.read(b, n, len - n);
            if (count <= 0) break;
            n += count;
        }
        return n;
    }
