class MingwSupport {
private final String sttyCommand;
private final String ttyCommand;
private final Pattern columnsPatterns;


public int getTerminalWidth(String name) {        try {            Process p = new ProcessBuilder(sttyCommand, "-F", name, "-a").start();            String result = waitAndCapture(p);            if (p.exitValue() != 0) {                throw new IOException("Error executing '" + sttyCommand + "': " + result);            }            Matcher matcher = columnsPatterns.matcher(result);            if (matcher.find()) {                return Integer.parseInt(matcher.group(1));            }            throw new IOException("Unable to parse columns");        } catch (Exception e) {            throw new RuntimeException(e);        }    }
}
```

