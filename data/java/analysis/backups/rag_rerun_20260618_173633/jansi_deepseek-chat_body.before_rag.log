w new RuntimeException(String.format(                                "Failed to write a native library file at %s because %s", extractedLibFile, eq));                    }                }            }            // Load library            if (loadNativeLibrary(extractedLibFile)) {                nativeLibrarySourceUrl =                        JansiLoader.class.getResource(nativeLibraryFilePath).toExternalForm();                return true;            }        } catch (IOException e) {            System.err.println(e.getMessage());        }        return false;    }
}
