class DefaultParser {


private boolean isLongOption(final String token) {        if (token == null || !token.startsWith("-") || token.length() == 1) {            return false;        }        final int pos = token.indexOf("=");        final String t = pos == -1 ? token : token.substring(0, pos);        if (!getMatchingLongOptions(t).isEmpty()) {            return true;        }        if (getLongPrefix(token) != null && !token.startsWith("--")) {            return true;        }        return false;    }
}
