protected void processProperties(final Properties properties) throws ParseException {        if (properties == null) {            return;        }        for (final Enumeration<?> e = properties.propertyNames(); e.hasMoreElements(); ) {            final String option = e.nextElement().toString();            final Option opt = options.getOption(option);            if (opt == null) {                throw new UnrecognizedOptionException("Default option wasn't defined", option);            }            final OptionGroup group = options.getOptionGroup(opt);            final boolean selected = group != null && group.getSelected() != null;            if (!cmd.hasOption2(option) && !selected) {                final String value = properties.getProperty(option);                if (opt.hasArg()) {                    if (opt.getValues() == null || opt.getValues().length == 0) {                        try {                            opt.addValueForProcessing(value);                        } catch (final RuntimeException exp) { // NOPMD                        }                    }                } else if (!("yes".equalsIgnoreCase(value)                        || "true".equalsIgnoreCase(value)                        || "1".equalsIgnoreCase(value))) {                    continue;                }                cmd.addOption(opt);                updateRequiredOptions(opt);            }        }    }
}
