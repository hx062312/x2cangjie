import std.net.*

main(): Int64 {
    // 创建不同的UnixSocketAddress实例
    let address1 = UnixSocketAddress("/tmp/server1.sock")
    let address2 = UnixSocketAddress("/tmp/server1.sock".toArray())

    // 使用toString()方法并打印结果
