class PosixParser {
private final List<String> tokens = new ArrayList<>();
private Option currentOption;
private Options options_field;


protected void burstToken(final String token, final boolean stopAtNonOption) {        for (int i = 1; i < token.length(); i++) {            final String ch = String.valueOf(token.charAt(i));            if (!options_field.hasOption(ch)) {                if (stopAtNonOption) {                    processNonOptionToken(token.substring(i), true);                } else {                    tokens.add(token);                }                break;            }            tokens.add("-" + ch);            currentOption = options_field.getOption(ch);            if (currentOption.hasArg() && token.length() != i + 1) {                tokens.add(token.substring(i + 1));                break;            }        }    }
}
