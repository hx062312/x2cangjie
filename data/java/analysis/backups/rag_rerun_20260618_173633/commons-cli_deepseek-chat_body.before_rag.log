.length() < max) {                optBuf.append(createPadding(max - optBuf.length()));            }            optBuf.append(dpad);            final int nextLineTabStop = max + descPad;            if (option.getDescription() != null) {                optBuf.append(option.getDescription());            }            renderWrappedText(sb, width, nextLineTabStop, optBuf.toString());            if (it.hasNext()) {                sb.append(getNewLine());            }        }        return sb;    }
}
