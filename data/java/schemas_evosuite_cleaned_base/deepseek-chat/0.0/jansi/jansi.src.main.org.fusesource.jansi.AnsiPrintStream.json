                "34-42:determineEncoding": {
                    "start": 34,
                    "end": 42,
                    "body": [
                        "private static String determineEncoding(Object args) throws UnsupportedEncodingException {",
                        "        if (args == null) {",
                        "            return null; // Use default encoding",
                        "        } else if (args instanceof String) {",
                        "            return (String) args;",
                        "        } else {",
                        "            throw new IllegalArgumentException(\"Invalid argument type\");",
                        "        }",
                        "    }"
                    ],
