                    "body": [
                        "private static String createMessage(",
                        "            final String option_param, final Collection<String> matchingOptions_param) {",
                        "        final StringBuilder buf = new StringBuilder(\"Ambiguous option: '\");",
                        "        buf.append(option_param);",
                        "        buf.append(\"'  (could be: \");",
                        "",
                        "        final Iterator<String> it = matchingOptions_param.iterator();",
                        "        while (it.hasNext()) {",
                        "            buf.append(\"'\");",
                        "            buf.append(it.next());",
                        "            buf.append(\"'\");",
                        "            if (it.hasNext()) {",
                        "                buf.append(\", \");",
                        "            }",
                        "        }",
                        "        buf.append(\")\");",
                        "",
                        "        return buf.toString();",
                        "    }"
                    ],
