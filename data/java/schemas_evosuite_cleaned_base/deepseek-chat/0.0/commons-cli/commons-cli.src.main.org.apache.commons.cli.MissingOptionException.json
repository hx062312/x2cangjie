                "34-48:createMessage": {
                    "start": 34,
                    "end": 48,
                    "body": [
                        "private static String createMessage(final List<?> missingOptions_param) {",
                        "        final StringBuilder buf = new StringBuilder(\"Missing required option\");",
                        "        buf.append(missingOptions_param.size() == 1 ? \"\" : \"s\");",
                        "        buf.append(\": \");",
                        "",
                        "        final Iterator<?> it = missingOptions_param.iterator();",
                        "        while (it.hasNext()) {",
                        "            buf.append(it.next());",
                        "            if (it.hasNext()) {",
                        "                buf.append(\", \");",
                        "            }",
                        "        }",
                        "",
                        "        return buf.toString();",
                        "    }"
                    ],
