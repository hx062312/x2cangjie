                        "public static Options parsePattern(final String pattern) {",
                        "        char opt = ' ';",
                        "        boolean required = false;",
                        "        Class<?> type__ = null;",
                        "",
                        "        final Options options = new Options();",
                        "",
                        "        for (int i = 0; i < pattern.length(); i++) {",
                        "            final char ch = pattern.charAt(i);",
                        "",
                        "            if (!isValueCode(ch)) {",
                        "                if (opt != ' ') {",
                        "                    final Option option =",
                        "                            Option.builder1(String.valueOf(opt))",
                        "                                    .hasArg1(type__ != null)",
                        "                                    .required1(required)",
                        "                                    .type_(type__)",
                        "                                    .build();",
                        "",
                        "                    options.addOption0(option);",
                        "                    required = false;",
                        "                    type__ = null;",
                        "                    opt = ' ';",
                        "                }",
                        "",
                        "                opt = ch;",
                        "            } else if (ch == '!') {",
                        "                required = true;",
                        "            } else {",
                        "                type__ = (Class<?>) getValueClass(ch);",
                        "            }",
                        "        }",
                        "",
                        "        if (opt != ' ') {",
                        "            final Option option =",
                        "                    Option.builder1(String.valueOf(opt))",
                        "                            .hasArg1(type__ != null)",
                        "                            .required1(required)",
                        "                            .type_(type__)",
                        "                            .build();",
                        "",
                        "            options.addOption0(option);",
                        "        }",
                        "",
                        "        return options;",
                        "    }"
                    ],
